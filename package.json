{
  "name": "gn-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "src/server/index.mjs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "test:emulator": "firebase emulators:exec --project demo-gn-engine --only firestore,auth 'node --test test/integration/*.test.mjs'",
    "deploy": "npm run build && firebase deploy --project gn-engine --only hosting,functions:api,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "express": "5.2.1",
    "firebase": "13.0.0",
    "firebase-tools": "15.34.0",
    "qrcode": "1.5.4"
  },
  "description": "GN Engine — scénario, inscription, attribution et accès privé sur Firebase"
}
